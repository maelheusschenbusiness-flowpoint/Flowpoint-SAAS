+export function escapeHtml(value: string): string {
+  return value
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+const EMAIL_PATTERN = /^[^\s@<>"',;]{1,64}@[^\s@<>"',;]{1,255}\.[^\s@<>"',;]{2,}$/;
+
+/** Validates the contact form body. Returns cleaned strings or an error message. */
+export function parseContactBody(body: unknown):
+  | { ok: true; name: string; email: string; subject: string; message: string }
+  | { ok: false; error: string } {
+  const b = (body ?? {}) as Record<string, unknown>;
+  const clean = (v: unknown) => (typeof v === "string" ? v.trim() : "");
+  const name = clean(b.name);
+  const email = clean(b.email);
+  const subject = clean(b.subject).replace(/[\r\n]+/g, " ");
+  const message = clean(b.message);
+  if (!name || !email || !subject || !message) return { ok: false, error: "Tous les champs sont requis" };
+  if (name.length > 120 || subject.length > 200 || message.length > 5000) return { ok: false, error: "Champ trop long" };
+  if (email.length > 320 || !EMAIL_PATTERN.test(email)) return { ok: false, error: "Adresse e-mail invalide" };
+  return { ok: true, name, email, subject, message };
+}
