diff -ruN a/client/src/lib/signup-url.ts b/client/src/lib/signup-url.ts
--- a/client/src/lib/signup-url.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/client/src/lib/signup-url.ts	2026-11-08 15:20:58.044356199 +0000
@@ -0,0 +1,56 @@
+// Single place that knows how the marketing site hands a visitor over to the
+// SaaS sign-up page (https://app.flowpoint.pro/signin.html).
+//
+// Contract with the SaaS (see saas-signin-plan-param.patch):
+//   ?plan=standard|pro|ultra   chosen card on /pricing; anything else is ignored
+//   ?fp_ref=SELLER-XXXX        seller referral code, copied from the page URL
+//
+// Nothing here reads or writes storage: it only builds URLs, so it is safe to
+// use before any consent decision. Visitor identifiers (fp_vid, fp_source,
+// UTM) stay in funnel-tracking.ts, which requires consent.
+
+export const SIGNUP_URL = "https://app.flowpoint.pro/signin.html";
+export const SIGNUP_PLANS = ["standard", "pro", "ultra"] as const;
+export type SignupPlan = (typeof SIGNUP_PLANS)[number];
+
+const APP_ORIGIN = "https://app.flowpoint.pro";
+const SELLER_REF_PATTERN = /^SELLER-[A-Z0-9]{1,20}$/;
+
+export function isSignupPlan(value: unknown): value is SignupPlan {
+  return typeof value === "string" && (SIGNUP_PLANS as readonly string[]).includes(value);
+}
+
+/** Sign-up URL for a pricing card. Unknown plans fall back to the plain URL. */
+export function signupUrlForPlan(plan?: string | null): string {
+  const normalized = (plan ?? "").trim().toLowerCase();
+  return isSignupPlan(normalized) ? `${SIGNUP_URL}?plan=${normalized}` : SIGNUP_URL;
+}
+
+/** Returns the canonical seller code or null when the value is not one. */
+export function normalizeSellerRef(value: string | null | undefined): string | null {
+  const candidate = (value ?? "").trim().toUpperCase();
+  return SELLER_REF_PATTERN.test(candidate) ? candidate : null;
+}
+
+/** Reads fp_ref (or its alias ref) from a query string such as location.search. */
+export function readSellerRefFromSearch(search: string): string | null {
+  const params = new URLSearchParams(search);
+  return normalizeSellerRef(params.get("fp_ref") ?? params.get("ref"));
+}
+
+/**
+ * Adds fp_ref to a link that targets the SaaS app. Existing parameters
+ * (plan, fp_vid, fp_source, utm_*, fp_lid) are preserved; links to any other
+ * origin are returned untouched.
+ */
+export function addSellerRefToAppUrl(href: string, ref: string | null): string {
+  if (!ref) return href;
+  try {
+    const url = new URL(href);
+    if (url.origin !== APP_ORIGIN) return href;
+    url.searchParams.set("fp_ref", ref);
+    return url.toString();
+  } catch {
+    return href;
+  }
+}
