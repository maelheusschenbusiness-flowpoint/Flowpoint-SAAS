    "cors": "^2",
    "drizzle-orm": "^0.45.0",
    "express": "^5",
    "googleapis": "^171.4.0",
    "helmet": "^8.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.9",
    "openai": "^6.35.0",
    "pdfkit": "^0.18.0",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.12.4",
    "stripe": "^22.1.0",
    "zod": "^3.24.1"
