{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=${NODE_ENV:-development} pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "migrate": "node ./build.mjs && node --enable-source-maps ./dist/migrate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:orphans": "node ../../scripts/verifier-tests-orphelins.mjs",
    "test:certification": "node --test tools/addon-cert-db-guard.test.mjs && node src/tests/billing-portal.test.cjs && tsx tests/certification/delete_defense_depth.test.ts && tsx tests/certification/monitor_cron_p1_fix.test.ts && tsx tests/certification/notification_robustness.test.ts && tsx tests/certification/settings_p1_fixes.test.ts && tsx tests/certification/store_me_elimination.test.ts",
    "custom-domain:cert-preflight": "tsx tools/custom-domain-cert-preflight.ts",
    "gsc:daily-sync": "tsx src/scripts/gsc-daily-sync.ts",
    "test:google-oauth-scopes": "vitest run src/services/google-oauth-scopes.test.ts --reporter=verbose",
    "assert:google-oauth-scopes": "node ./scripts/assert-google-oauth-scopes.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@google/genai": "^2.11.0",
    "@types/compression": "^1.8.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "^0.45.0",
    "exceljs": "^4.4.0",
    "express": "^5",
    "googleapis": "^171.4.0",
    "helmet": "^8.2.0",
    "mammoth": "^1.12.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.1.7",
    "openai": "^6.35.0",
    "papaparse": "^5.5.4",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.18.0",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.12.4",
    "stripe": "^22.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "5.1.1",
    "@types/node": "^20.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pg": "^8.20.0",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "^4.19.4",
    "vitest": "^4.1.12"
  }
}
